generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/cloud-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         String     @default("USER")
  createdAt    DateTime   @default(now())
  deckCards    DeckCard[]
}

model DeckCard {
  id          String   @id @default(cuid())
  ownerId     String
  section     String
  cardApiId   Int
  cardName    String
  cardImage   String
  cardType    String
  description String
  atk         Int?
  def         Int?
  level       Int?
  quantity    Int      @default(1)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, section, cardApiId])
  @@index([ownerId, section])
  @@index([cardApiId])
}

model AppDocument {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
