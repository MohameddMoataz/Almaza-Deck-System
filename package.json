{
  "name": "kaibacorp-deck-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "test:deck": "tsx --test tests/deck-rules.test.ts tests/deck-storage.test.ts",
    "test:translations": "tsx --test tests/arabic-translations.test.ts",
    "dev": "next dev",
    "build": "prisma generate && prisma generate --schema prisma/cloud/schema.prisma && next build",
    "postinstall": "prisma generate && prisma generate --schema prisma/cloud/schema.prisma",
    "cloud:migrate": "prisma migrate deploy --schema prisma/cloud/schema.prisma",
    "cloud:seed": "tsx scripts/seed-cloud.ts",
    "cloud:check": "tsx scripts/check-cloud.ts",
    "export:local": "tsx scripts/export-local.ts",
    "cloud:import": "tsx scripts/import-cloud.ts",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma generate --schema prisma/cloud/schema.prisma && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "15.5.27",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.6.3"
  }
}
